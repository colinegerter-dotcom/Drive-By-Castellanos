SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=changeme

# No key needed for MLB Stats API or Open-Meteo -- both are open, unauthenticated APIs.
